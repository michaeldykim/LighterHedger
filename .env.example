# Lighter trading API key, NOT your wallet private key.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# Dedicated Telegram bot; use a private chat (positive numeric ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: mirror new notifications to a private Discord server text channel.
# Secret URL from Edit Channel > Integrations > Webhooks. Never share or log it.
DISCORD_WEBHOOK_URL=
